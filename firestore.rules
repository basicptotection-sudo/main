/**
 * # Firestore Security Rules
 *
 * ## Core Philosophy
 * This ruleset implements a secure "write-only" or "append-only" log for public form submissions.
 * The primary goal is to allow anyone to submit a lead or contact request through a public-facing form while ensuring that this sensitive information is immediately locked down and made inaccessible from the client-side. All reads and modifications must be handled by a trusted backend service (e.g., Cloud Functions) with admin privileges.
 *
 * ## Data Structure
 * The data is organized into two flat top-level collections:
 * - /lead_requests/{leadRequestId}: Stores individual lead submissions.
 * - /contact_requests/{contactRequestId}: Stores individual contact submissions.
 *
 * ## Key Security Decisions
 * - Public Creation: Anyone can create a new document in the `lead_requests` and `contact_requests` collections. This is necessary for the public forms to function.
 * - No Client-Side Reads: All `get` and `list` operations are explicitly denied to prevent any user from accessing or discovering PII from other submissions.
 * - Immutable Submissions: Once a request is created, it cannot be updated or deleted from the client. This protects the integrity of the submitted data.
 * - Minimal Validation: We perform a minimal sanity check on creation (ensuring a `submissionDate` field is present) rather than enforcing a strict schema. This provides a basic guard against completely empty writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    
    /**
     * Performs a minimal validation check for a new submission.
     * This check simply ensures the request is not completely empty by requiring a 'submissionDate' field,
     * which is a reasonable expectation for any form submission.
     */
    function isPublicSubmission() {
      return 'submissionDate' in request.resource.data;
    }

    /**
     * @description
     *   Allows any user to submit a new lead request but prevents anyone from reading,
     *   updating, or deleting existing requests. This creates a secure write-only
     *   collection for public form submissions.
     */
    match /lead_requests/{leadRequestId} {
      // READ RULES: Deny all client-side reads to protect sensitive lead information.
      allow get: if false;
      allow list: if false;

      // WRITE RULES: Allow public creation but deny modifications.
      allow create: if isPublicSubmission();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description
     *   Allows any user to submit a new contact request but prevents anyone from reading,
     *   updating, or deleting existing requests. This creates a secure write-only
     *   collection for the public contact form.
     */
    match /contact_requests/{contactRequestId} {
      // READ RULES: Deny all client-side reads.
      allow get: if false;
      allow list: if false;

      // WRITE RULES: Allow public creation but deny modifications.
      allow create: if isPublicSubmission();
      allow update: if false;
      allow delete: if false;
    }
  }
}