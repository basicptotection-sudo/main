{
  "firestore": {
    "rules": "firestore.rules"
  },
  "apphosting": [
    {
      "backendId": "basic",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "out",
        ".firebase",
        ".agents",
        ".codex",
        ".vscode",
        ".idx",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env",
        ".env.*",
        "!.env.example",
        "*.tsbuildinfo"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
